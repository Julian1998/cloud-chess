  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.3"
