{
  "name": "@cloud-chess/nextcloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css}\" \"*.{ts,json}\" \"../../../packages/chess-core/composer.json\" \"../../../.prettierrc.json\"",
