{
  "name": "@cloud-chess/nextcloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "format": "prettier --ignore-path ../../../.prettierignore --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json,yaml}\" \"../../../packages/chess-core/composer.json\" \"../../../.prettierrc.json\"",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json,yaml}\" \"../../../packages/chess-core/composer.json\" \"../../../.prettierrc.json\""
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  }
}
