{
  "name": "cloud-chess/chess-core",
  "description": "Portable application core for Chess.",
  "type": "library",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3.1",
    "phpunit/phpunit": "^12.5.38",
    "friendsofphp/php-cs-fixer": "^3.95.27"
  },
  "autoload": {
    "psr-4": {
      "CloudChess\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloudChess\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration=phpunit.xml",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "format": "php-cs-fixer fix --config=../../.php-cs-fixer.dist.php",
    "format:check": "php-cs-fixer fix --config=../../.php-cs-fixer.dist.php --dry-run --diff"
  }
}
